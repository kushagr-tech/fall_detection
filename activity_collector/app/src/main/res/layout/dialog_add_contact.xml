<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickFromContacts"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="📇  Choose from Saved Contacts"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary_emerald"
        style="@style/Widget.Material3.Button.TonalButton"
        android:backgroundTint="@color/primary_emerald_light"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  OR ENTER MANUALLY  "
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_tertiary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/divider" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Contact Name"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etContactName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="e.g. Mom, Doctor, Caregiver"
        android:inputType="textPersonName"
        android:textSize="15sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:background="@drawable/edittext_background"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Phone Number"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etContactPhone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="e.g. +91 9876543210"
        android:inputType="phone"
        android:textSize="15sp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:background="@drawable/edittext_background"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Note: The 1st contact in the list receives an automated phone call. All contacts receive an emergency SMS with GPS coordinates."
        android:textSize="12sp"
        android:textColor="@color/text_secondary" />

</LinearLayout>
