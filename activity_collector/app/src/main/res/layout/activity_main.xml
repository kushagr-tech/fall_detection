<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ── Title ─────────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp" />

        <!-- ── Recording status bar ──────────────────────────────────────── -->
        <View
            android:id="@+id/statusIndicator"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:background="@color/recording_idle"
            android:layout_marginBottom="16dp" />

        <!-- ══════════════════════════════════════════════════════════════════
             INFERENCE PANEL — live activity + confidence
             ══════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <!-- Label: "LIVE DETECTION" -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/inference_title"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.12"
                android:layout_marginBottom="10dp" />

            <!-- Activity: WALKING -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_prefix"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvActivityLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/activity_idle"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace" />

            </LinearLayout>

            <!-- Confidence: 96% -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/confidence_prefix"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvConfidence"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

            <!-- Confidence bar -->
            <ProgressBar
                android:id="@+id/tvConfidenceBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/btn_start"
                android:progressBackgroundTint="@color/recording_idle" />

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════════════════
             FALL STATUS — phase indicator
             ══════════════════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/tvFallStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- ══════════════════════════════════════════════════════════════════
             FALL ALERT BANNER — shown when fall is confirmed (before dialog)
             ══════════════════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/tvFallBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fall_banner_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@color/fall_alert_bg"
            android:padding="12dp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- ── Activity label selector ───────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_activity"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerLabel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/spinner_background"
            android:layout_marginBottom="14dp" />

        <!-- ── Sampling rate ─────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_sampling_rate"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etSamplingRate"
                android:layout_width="100dp"
                android:layout_height="48dp"
                android:inputType="number"
                android:textSize="16sp"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:background="@drawable/edittext_background"
                android:maxLength="3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hz_label"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="10dp" />

        </LinearLayout>

        <!-- ── Stats card ─────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stats_title"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.12"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duration_label"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duration_default"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/samples_label"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvSampleCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/samples_default"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════════════════
             EMERGENCY SOS CONTACTS
             ══════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="EMERGENCY SOS CONTACTS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tvContactCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 contacts"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="If a fall is uncancelled, an automated call is placed to Contact #1 (Primary) and an emergency SMS with your GPS location is sent to all contacts."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="12dp" />

            <!-- Container for dynamic contact items -->
            <LinearLayout
                android:id="@+id/contactsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvEmptyContacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ No emergency contacts added yet.\nTap below to add family or caregivers."
                android:textSize="13sp"
                android:textColor="@color/phase_orange"
                android:gravity="center"
                android:padding="12dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnAddContact"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="+ Add Emergency Contact"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/btn_export" />

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════════════════
             BACKGROUND PERSISTENCE / BATTERY OPTIMIZATION
             ══════════════════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/cardBatteryOptimization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvBatteryIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="⚡"
                android:textSize="18sp"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBatteryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24/7 Background Protection"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvBatterySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to enable unrestricted background execution"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvBatteryAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fix →"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/btn_export"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />

        </LinearLayout>

        <!-- ── Control buttons ──────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/btn_start"
                android:textSize="15sp"
                android:backgroundTint="@color/btn_start"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="@string/btn_stop"
                android:textSize="15sp"
                android:backgroundTint="@color/btn_stop"
                android:enabled="false"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnExport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_export"
            android:textSize="15sp"
            android:backgroundTint="@color/btn_export" />

    </LinearLayout>
</ScrollView>
